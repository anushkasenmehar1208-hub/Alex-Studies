# =============================================================================
# Alex Studies — Production Environment Variables (Vercel Frontend)
# =============================================================================
# Set these in Vercel Project Settings → Environment Variables.
# NEVER commit actual secrets to git.

# -----------------------------------------------------------------------------
# Core Application
# -----------------------------------------------------------------------------
# Public frontend URL
APP_BASE_URL=https://alexstudies.com

# Backend URL for Next.js middleware proxy.
# Initially: Render's auto-generated URL (e.g., https://alex-studies.onrender.com)
# After custom domain: https://backend.alexstudies.com
REFLEX_BACKEND_URL=https://backend.alexstudies.com

# -----------------------------------------------------------------------------
# Database (Neon PostgreSQL) — Required for Next.js auth/onboarding APIs
# -----------------------------------------------------------------------------
# Same Neon connection string as Render backend
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# -----------------------------------------------------------------------------
# Google OAuth (for proxy architecture)
# -----------------------------------------------------------------------------
# The redirect URI must be the frontend domain so the callback goes through
# Vercel → middleware → Render, and the post-auth redirect lands on the frontend.
# Authorized redirect URI in Google Cloud Console:
#   https://alexstudies.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://alexstudies.com/auth/google/callback