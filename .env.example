# =============================================================================
# Alex Studies — Production Environment Variables (Render Backend)
# =============================================================================
# Copy this file to .env for local development, or set these in Render's
# Environment Variables dashboard. NEVER commit actual secrets to git.

# -----------------------------------------------------------------------------
# Core Application
# -----------------------------------------------------------------------------
# Public frontend URL (Vercel deployment)
APP_BASE_URL=https://alexstudies.com

# Backend API URL for Reflex WebSocket/API connections.
# In production with Next.js proxy (Vercel → Render), this should be the
# frontend URL because the middleware proxies /api/* and /_event to the backend.
# Set explicitly only if you need direct backend access (bypassing proxy).
# REFLEX_API_URL=https://alexstudies.com

# Generic API URL fallback (used if REFLEX_API_URL not set)
# API_URL=https://alexstudies.com

# -----------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# -----------------------------------------------------------------------------
# Neon connection string with SSL (required)
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# -----------------------------------------------------------------------------
# Authentication & Sessions
# -----------------------------------------------------------------------------
# Strong random secret (32+ chars) for signing cookies, OAuth state, media URLs
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Google OAuth 2.0 (for "Sign in with Google")
# Create credentials in Google Cloud Console → APIs & Services → Credentials
# IMPORTANT: Authorized redirect URI must be:
#   https://alexstudies.com/auth/google/callback
# This ensures the OAuth callback goes through Vercel → Next.js middleware → Render backend,
# and the post-auth redirect lands on the Next.js frontend (alexstudies.com).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Override redirect URI for production proxy architecture (Vercel → Render)
# Set to: https://alexstudies.com/auth/google/callback
GOOGLE_REDIRECT_URI=https://alexstudies.com/auth/google/callback

# CSRF cookie secure flag (true for HTTPS production)
CSRF_COOKIE_SECURE=true

# Login rate limiting
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCK_MINUTES=10

# -----------------------------------------------------------------------------
# AI Services (Required for core tutoring features)
# -----------------------------------------------------------------------------
# OpenRouter API key (primary LLM provider for chat, routing, vision, diagrams)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: Override specific model IDs (defaults are set in code)
# OPENROUTER_TEACHER_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_REASONING_MODEL=deepseek/deepseek-r1
# OPENROUTER_PREMIUM_MODEL=anthropic/claude-opus-4-7
# OPENROUTER_AUX_MODEL=
# OPENROUTER_AUX_FALLBACK_MODEL=anthropic/claude-haiku-4.5
# OPENROUTER_VISION_MODEL=openai/gpt-5.5-pro
# OPENROUTER_DRAW_MODEL=openai/gpt-5.5-pro
# OPENROUTER_SPEC_MODEL=deepseek/deepseek-chat
# OPENROUTER_VOICE_MODEL=

# -----------------------------------------------------------------------------
# Optional AI Services (Enhancements)
# -----------------------------------------------------------------------------
# OpenAI API key (for TTS, STT, image generation)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model overrides (defaults in code)
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# OPENAI_IMAGE_MODEL=gpt-image-2

# Fish Audio TTS (high-quality voice "Sol")
# Get from: https://fish.audio
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=cb41574b02f44753b5a9ee4fb929dd8d
FISH_AUDIO_MODEL=s2-pro

# YouTube transcript API (Supadata - cloud-safe, recommended)
# Get from: https://supadata.ai
SUPADATA_API_KEY=

# YouTube transcript proxy (if youtube-transcript-api is blocked on cloud IPs)
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=
# YOUTUBE_TRANSCRIPT_PROXY_URL=

# -----------------------------------------------------------------------------
# Payments (Dodo Payments)
# -----------------------------------------------------------------------------
# Live API key from Dodo Payments dashboard
DODO_PAYMENTS_API_KEY=

# Product IDs for each plan (create in Dodo Payments → Products)
DODO_PAYMENTS_PRODUCT_ID=          # Pro plan ($3/mo)
DODO_PAYMENTS_MAX_PRODUCT_ID=      # Max plan ($25/mo)
DODO_PAYMENTS_ULTRA_PRODUCT_ID=    # Ultra plan ($100/mo)

# Webhook secret (set in Dodo Payments → Webhooks)
DODO_PAYMENTS_WEBHOOK_SECRET=

# Optional: override API URL (defaults to live.dodopayments.com)
# DODO_PAYMENTS_API_URL=https://live.dodopayments.com/checkouts

# Return/failure URLs after checkout (must be HTTPS in production)
DODO_PAYMENTS_RETURN_URL=https://alexstudies.com/app
DODO_PAYMENTS_FAILURE_URL=https://alexstudies.com/pricing

# -----------------------------------------------------------------------------
# Legacy Payments (Gumroad) — Optional
# -----------------------------------------------------------------------------
GUMROAD_PING_SECRET=
GUMROAD_SELLER_ID=
GUMROAD_PRODUCT_ID=

# -----------------------------------------------------------------------------
# Cost Control & Monitoring (Optional)
# -----------------------------------------------------------------------------
# ALEX_PREMIUM_GLOBAL_FRACTION_MAX=0.03
# ALEX_PREMIUM_PER_USER_DAILY=15
# ALEX_PREMIUM_ROLLING_1H_MAX=120
# ALEX_EMERGENCY_COST_MODE=false
# LOG_REQUEST_PERSISTED=true

# -----------------------------------------------------------------------------
# App Settings
# -----------------------------------------------------------------------------
APP_TIMEZONE=Asia/Colombo
APP_LOG_LEVEL=INFO
ENFORCE_HTTPS=true
MEDIA_URL_MAX_AGE_SECONDS=86400

# -----------------------------------------------------------------------------
# Video Service (Separate Deployment)
# -----------------------------------------------------------------------------
# URL of the deployed Alex Video Service (Manim renderer)
# ALEX_VIDEO_SERVICE_URL=https://your-video-service.onrender.com

# ElevenLabs (if used for voice)
# ELEVENLABS_API_KEY=