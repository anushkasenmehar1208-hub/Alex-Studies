# ---------------------------------------------------------------------------
# Root .dockerignore — production-safe build context for the Reflex image
# Dockerfile: COPY . . → everything not listed here is copied into the image.
# Only dev-local artifacts, tooling state, and secrets are excluded below.
# ---------------------------------------------------------------------------

# --- Secrets — NEVER inside the image ---
.env
.env.*
!.env.example
!alex_video_service/.env.example

# --- Git / CI / agent tooling state ---
.git
.github
.claude
.freebuff
.cursor
.vscode
.idea

# --- Virtual environments ---
.venv
.venv/
.venv_new
.venv_new/
venv
venv/
env
env/
ENV
ENV/

# --- Reflex local build/state dirs (regenerated by reflex export during build) ---
.web
.states
.reflex

# --- Local databases ---
*.db
*.sqlite
*.sqlite3

# --- macOS / OS noise ---
.DS_Store

# --- Python build/test cache ---
__pycache__
**/__pycache__
*.py[cod]
*.pyc
**/*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache

# --- Node artifacts (main app is Python; next-app has its own image) ---
node_modules
**/node_modules
.next
.vercel
**/.vercel
.next-env.d.ts

# --- Runtime upload dirs (created on demand at runtime) ---
uploaded_files
.chat_media
.codex_video_frames

# --- Local-only code not used by the Reflex runtime ---
tests
tools
alex_video_service
next-app

# --- One-off local artifacts (kept in git history, never in the image) ---
kelaniya_handbook.pdf
.tmp_kelaniya_handbook.txt
.tmp_kelaniya_shortpdf.txt
frontend.zip
UNI_APP.MP3
UNI_APP.mp4
city3d.html
test_avatar.html
test_vv.js
build_scene.py
fix_girl.py
pylint_report.txt
uni_app_tail.txt
import.log
reflex_import.log
onboarding_bg.png
sitemap.xml
robots.txt

# --- Docs not needed by the Reflex runtime ---
README.md
TODO.md

# ---------------------------------------------------------------------------
# KEPT IN THE IMAGE: Dockerfile, start.sh, railway.toml, requirements.txt,
# rxconfig.py, alembic/, uni_app/ (incl. pregenerated_plans/), assets/,
# and every file the Reflex build/runtime needs.
# ---------------------------------------------------------------------------
